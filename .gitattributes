# Normaliza as quebras de linha: o repositório guarda LF e cada máquina
# converte conforme o sistema. Evita centenas de "arquivos modificados" que
# são só diferença entre LF e CRLF.
* text=auto

*.sh   text eol=lf
Dockerfile text eol=lf
*.ps1  text eol=crlf

*.png  binary
*.jpg  binary
*.gif  binary
*.zip  binary
